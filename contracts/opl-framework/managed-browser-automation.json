{
  "schema": "opl_framework_managed_browser_automation.v1",
  "owner": "one-person-lab",
  "product_policy_source_ref": "one-person-lab-app/contracts/app-gui-product-contract.json#computer_use_policy.browser_provider",
  "product_policy_source_sha256": "f8b32b5bc88efc8d58c211c023efb61e734536c8066ea1d6ee85b41696a523e2",
  "provider_id": "playwright-mcp",
  "product_name": "Browser Automation",
  "runtime": {
    "package_name": "@playwright/mcp",
    "entrypoint": "cli.js",
    "node_minimum_version": "20.0.0",
    "dependency_source_ref": "contracts/opl-framework/dependency-release-sources.json#playwright-mcp",
    "carrier": "opl_managed_npm_with_framework_first_run_seed"
  },
  "mcp": {
    "server_id": "playwright",
    "args": [
      "--browser",
      "chrome",
      "--headless",
      "--isolated"
    ],
    "protocol_version": "2025-06-18",
    "default_enabled": true,
    "required_tools": [
      "browser_close",
      "browser_resize",
      "browser_console_messages",
      "browser_handle_dialog",
      "browser_evaluate",
      "browser_file_upload",
      "browser_drop",
      "browser_find",
      "browser_fill_form",
      "browser_press_key",
      "browser_type",
      "browser_navigate",
      "browser_navigate_back",
      "browser_network_requests",
      "browser_network_request",
      "browser_run_code_unsafe",
      "browser_take_screenshot",
      "browser_snapshot",
      "browser_click",
      "browser_drag",
      "browser_hover",
      "browser_select_option",
      "browser_tabs",
      "browser_wait_for"
    ]
  },
  "browser": {
    "mode": "isolated_headless_system_chrome",
    "channel": "chrome",
    "host_browser_required_for_ready": true,
    "host_browser_paths": [
      "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
      "/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary"
    ],
    "output_owner": "opl_state",
    "existing_chrome_session_reuse": false,
    "existing_chrome_session_followup": "kimi_webbridge_or_cdp_after_separate_validation",
    "desktop_visual_fallback_provider": "kimi-cu"
  },
  "degradation": {
    "provider_failure_blocks_plain_codex": false,
    "provider_failure_blocks_kimi_cu": false,
    "kimi_cu_failure_blocks_provider": false
  },
  "authority_boundary": {
    "codex_mcp_registry_writer": "src/adapters/integration/system-installation/codex-plugin-registry.ts#registerOplManagedMcpServer",
    "second_registry_or_catalog_allowed": false,
    "second_session_store_or_agent_loop_allowed": false,
    "global_npm_mutation_allowed": false,
    "npx_latest_runtime_resolution_allowed": false,
    "app_release_ready_claim_allowed": false
  },
  "action_ids": [
    "settings_recheck_browser_automation",
    "settings_repair_browser_automation"
  ]
}
